# Contestador de Instagram · variables de entorno de las Edge Functions.
# En Supabase: Project Settings → Edge Functions → Secrets (o `supabase secrets set --env-file .env`).
# Nunca subas un .env real a git.

# --- Las inyecta Supabase automáticamente en las funciones (no hace falta definirlas en producción) ---
# SUPABASE_URL: URL del proyecto (la pone Supabase sola, no la añadas)
# SUPABASE_SERVICE_ROLE_KEY: Clave service role: acceso total a la BD, solo servidor (la pone Supabase sola, no la añadas)

# --- Acceso al panel ---
# Contraseña del panel (cabecera x-admin-password)
ADMIN_PASSWORD=cambia-esta-contraseña-larga
# Origen permitido para CORS (vacío = "*", solo para pruebas)
PANEL_ORIGIN=https://tu-dominio.com
# Adónde vuelve el OAuth tras conectar la cuenta
PANEL_URL=https://tu-dominio.com/panel/

# --- App de Meta (Instagram API con Instagram Login) ---
# ID de la app de Meta (también va en panel/config.js)
IG_APP_ID=000000000000000
# Secreto de la app: canjea códigos OAuth y verifica la firma de Meta
INSTAGRAM_APP_SECRET=TU_APP_SECRET
# Token que escribes en Meta al configurar el webhook (GET de verificación)
IG_VERIFY_TOKEN=cadena-aleatoria-para-el-webhook
# Versión de la Graph API (opcional)
GRAPH_API_VERSION=v21.0
# Base de la API de Instagram (opcional, no cambiar salvo que Meta lo indique)
GRAPH_BASE=https://graph.instagram.com

# --- Fallback sin OAuth (opcional): cuenta y token fijados por variable ---
# ID numérico de la cuenta de Instagram (opcional)
IG_ACCOUNT_ID=
# Token de larga duración de esa cuenta (opcional)
IG_ACCESS_TOKEN=

# --- Límites ---
# Máximo de DMs automáticos por hora (protección anti-ráfaga)
RATE_LIMIT_PER_HOUR=200

# --- Cron (ig-refresh) ---
# Se envía en la cabecera x-cron-secret desde pg_cron
CRON_SECRET=cadena-aleatoria-para-el-cron

# --- IA para sugerir textos en el panel (opcional) ---
# Si está vacía, el botón de IA avisa y no hace nada
ANTHROPIC_API_KEY=
# Modelo a usar para ai_copy
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Email (todo opcional: si falta algo, ese paso se omite) ---
# Envío de bienvenida y avisos de error de OAuth
RESEND_API_KEY=
# Remitente verificado en Resend (necesario para la bienvenida)
EMAIL_FROM="Tu Nombre <hola@tu-dominio.com>"
# Dónde llegan los avisos de fallo de conexión
ALERT_EMAIL=tu@email.com
# Cada email capturado se envía aquí por POST (Make, Zapier, tu herramienta de newsletter)
EMAIL_WEBHOOK_URL=

# --- Textos legales (privacy y data-deletion) ---
# Responsable del tratamiento
LEGAL_CONTROLLER_NAME="Tu Nombre o Empresa"
# Contacto para derechos y eliminación de datos
LEGAL_CONTACT_EMAIL=privacidad@tu-dominio.com
# Nombre de la app que aparece en los textos
LEGAL_APP_NAME="Contestador de Instagram"
# Fecha de la última actualización de la política (opcional)
LEGAL_UPDATED_AT=
